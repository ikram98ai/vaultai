{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vaultai",
  "version": "0.1.0",
  "identifier": "com.ikram.vaultai",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:vaultai.db"]
    }
  },
  "app": {
    "windows": [
      {
        "title": "vaultai",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "resources": ["../models/"],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
